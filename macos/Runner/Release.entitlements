<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Off: agents run the Claude Code CLI as a child process and read
	     its sessions in ~/.claude, which a sandboxed app cannot. -->
	<key>com.apple.security.app-sandbox</key>
	<false/>
	<!-- Signed for release the app has the hardened runtime, which blocks
	     Apple Events, its children's too, unless this is on; see
	     NSAppleEventsUsageDescription in Info.plist. -->
	<key>com.apple.security.automation.apple-events</key>
	<true/>
</dict>
</plist>
