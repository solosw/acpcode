+// Copyright 2013 The Flutter Authors. All rights reserved.
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef FLUTTER_IMPELLER_TYPOGRAPHER_WINDOWS_TEXT_TUNING_H_
+#define FLUTTER_IMPELLER_TYPOGRAPHER_WINDOWS_TEXT_TUNING_H_
+
+#include <optional>
+
+namespace impeller {
+
+/// How alpha-only glyphs are rasterized and blended on Windows.
+///
+/// The defaults follow Chrome on Windows: glyphs drawn as light text get
+/// their own atlas entries, so Skia's mask preblend sees the text's real
+/// luminance, and the glyph contrast comes from the user's ClearType tuning
+/// (or 1.0) instead of Skia's 0.5. The shader's luminance-based gamma
+/// approximation is then turned off, since the preblend already did that
+/// work.
+///
+/// Every field can be overridden with an environment variable, read once
+/// per process, to compare renderings without rebuilding:
+///
+///   FLUTTER_WIN_TEXT=off                 stock Flutter behavior
+///   FLUTTER_WIN_TEXT_LIGHT_GLYPHS=0|1
+///   FLUTTER_WIN_TEXT_SHADER_GAMMA=0|1
+///   FLUTTER_WIN_TEXT_CONTRAST=<0..1>     Skia text contrast
+///   FLUTTER_WIN_TEXT_GAMMA=<0..4)        Skia text gamma, 0 is sRGB
+///
+/// On other platforms the values are the stock ones and are unused.
+struct WindowsTextTuning {
+  /// Whether light text gets light glyphs, as on macOS.
+  bool light_glyphs = false;
+
+  /// Whether the glyph shader applies its luminance-based gamma.
+  bool shader_gamma = true;
+
+  /// Skia's text contrast for glyph rasterization; Skia's default if unset.
+  std::optional<float> contrast;
+
+  /// Skia's text gamma for glyph rasterization; Skia's default if unset.
+  std::optional<float> gamma;
+};
+
+/// The process's tuning, computed on first use.
+const WindowsTextTuning& GetWindowsTextTuning();
+
+}  // namespace impeller
+
+#endif  // FLUTTER_IMPELLER_TYPOGRAPHER_WINDOWS_TEXT_TUNING_H_
