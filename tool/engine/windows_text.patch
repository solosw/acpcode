diff --git a/engine/src/flutter/impeller/typographer/windows_text_tuning.cc b/engine/src/flutter/impeller/typographer/windows_text_tuning.cc
new file mode 100644
index 0000000..d734d15
--- /dev/null
+++ b/engine/src/flutter/impeller/typographer/windows_text_tuning.cc
@@ -0,0 +1,199 @@
+// Copyright 2013 The Flutter Authors. All rights reserved.
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "impeller/typographer/windows_text_tuning.h"
+
+#include "flutter/fml/build_config.h"
+
+#if FML_OS_WIN
+#include <windows.h>
+
+#include <dwrite.h>
+
+#include <cmath>
+#include <cstdlib>
+#include <cstring>
+#include <cwchar>
+#include <string>
+
+#include "flutter/fml/logging.h"
+#endif
+
+namespace impeller {
+
+#if FML_OS_WIN
+
+namespace {
+
+// SkSurfaceProps' accepted ranges: contrast in [0, 1], gamma in [0, 4).
+float ClampContrast(float value) {
+  if (!(value >= 0.0f)) {
+    return 0.0f;
+  }
+  return value > 1.0f ? 1.0f : value;
+}
+
+float ClampGamma(float value) {
+  if (!(value >= 0.0f)) {
+    return 0.0f;
+  }
+  const float limit = std::nextafter(4.0f, 0.0f);
+  return value > limit ? limit : value;
+}
+
+std::optional<std::string> ReadEnv(const char* name) {
+  char buffer[64];
+  DWORD length = ::GetEnvironmentVariableA(name, buffer, sizeof(buffer));
+  if (length == 0 || length >= sizeof(buffer)) {
+    return std::nullopt;
+  }
+  return std::string(buffer, length);
+}
+
+std::optional<bool> ReadEnvBool(const char* name) {
+  std::optional<std::string> value = ReadEnv(name);
+  if (!value.has_value()) {
+    return std::nullopt;
+  }
+  const char* text = value->c_str();
+  if (std::strcmp(text, "1") == 0 || _stricmp(text, "on") == 0 ||
+      _stricmp(text, "true") == 0) {
+    return true;
+  }
+  if (std::strcmp(text, "0") == 0 || _stricmp(text, "off") == 0 ||
+      _stricmp(text, "false") == 0) {
+    return false;
+  }
+  return std::nullopt;
+}
+
+std::optional<float> ReadEnvFloat(const char* name) {
+  std::optional<std::string> value = ReadEnv(name);
+  if (!value.has_value()) {
+    return std::nullopt;
+  }
+  const char* text = value->c_str();
+  char* end = nullptr;
+  float result = std::strtof(text, &end);
+  if (end == text || *end != '\0' || !std::isfinite(result)) {
+    return std::nullopt;
+  }
+  return result;
+}
+
+// Whether the user ran the ClearType Text Tuner, which keeps its choices
+// under a key named after the primary display. Like Chrome, only then are
+// DirectWrite's rendering params used: their defaults don't match Skia's.
+bool HasClearTypeTuning() {
+  DISPLAY_DEVICEW device = {};
+  device.cb = sizeof(device);
+  for (DWORD i = 0; ::EnumDisplayDevicesW(nullptr, i, &device, 0); ++i) {
+    if (!(device.StateFlags & DISPLAY_DEVICE_PRIMARY_DEVICE)) {
+      continue;
+    }
+    // DeviceName reads like "\\.\DISPLAY1"; the key is "DISPLAY1".
+    const wchar_t* name = device.DeviceName;
+    if (const wchar_t* slash = std::wcsrchr(name, L'\\')) {
+      name = slash + 1;
+    }
+    std::wstring path = L"SOFTWARE\\Microsoft\\Avalon.Graphics\\";
+    path += name;
+    HKEY key = nullptr;
+    if (::RegOpenKeyExW(HKEY_CURRENT_USER, path.c_str(), 0, KEY_READ, &key) !=
+        ERROR_SUCCESS) {
+      return false;
+    }
+    ::RegCloseKey(key);
+    return true;
+  }
+  return false;
+}
+
+// The primary display's DirectWrite contrast and gamma. dwrite.dll is
+// loaded at runtime so the engine's link inputs stay as they are.
+bool ReadDirectWriteParams(float* contrast, float* gamma) {
+  HMODULE dwrite = ::LoadLibraryW(L"dwrite.dll");
+  if (!dwrite) {
+    return false;
+  }
+  using CreateFactory =
+      HRESULT(WINAPI*)(DWRITE_FACTORY_TYPE, REFIID, IUnknown**);
+  auto create = reinterpret_cast<CreateFactory>(reinterpret_cast<void*>(
+      ::GetProcAddress(dwrite, "DWriteCreateFactory")));
+  bool read = false;
+  IDWriteFactory* factory = nullptr;
+  if (create &&
+      SUCCEEDED(create(DWRITE_FACTORY_TYPE_SHARED, __uuidof(IDWriteFactory),
+                       reinterpret_cast<IUnknown**>(&factory)))) {
+    IDWriteRenderingParams* params = nullptr;
+    if (SUCCEEDED(factory->CreateRenderingParams(&params))) {
+      *contrast = params->GetEnhancedContrast();
+      *gamma = params->GetGamma();
+      params->Release();
+      read = true;
+    }
+    factory->Release();
+  }
+  // dwrite.dll stays loaded: Skia's font manager uses it all along.
+  return read;
+}
+
+WindowsTextTuning ComputeTuning() {
+  WindowsTextTuning tuning;
+
+  std::optional<bool> enabled = ReadEnvBool("FLUTTER_WIN_TEXT");
+  if (enabled.value_or(true)) {
+    tuning.light_glyphs = true;
+    tuning.shader_gamma = false;
+    // Chrome's SK_GAMMA_CONTRAST on Windows; the gamma stays Skia's (sRGB).
+    tuning.contrast = 1.0f;
+    float contrast = 0.0f;
+    float gamma = 0.0f;
+    if (HasClearTypeTuning() && ReadDirectWriteParams(&contrast, &gamma)) {
+      tuning.contrast = ClampContrast(contrast);
+      tuning.gamma = ClampGamma(gamma);
+    }
+  }
+
+  if (auto value = ReadEnvBool("FLUTTER_WIN_TEXT_LIGHT_GLYPHS")) {
+    tuning.light_glyphs = *value;
+  }
+  if (auto value = ReadEnvBool("FLUTTER_WIN_TEXT_SHADER_GAMMA")) {
+    tuning.shader_gamma = *value;
+  }
+  if (auto value = ReadEnvFloat("FLUTTER_WIN_TEXT_CONTRAST")) {
+    tuning.contrast = ClampContrast(*value);
+  }
+  if (auto value = ReadEnvFloat("FLUTTER_WIN_TEXT_GAMMA")) {
+    tuning.gamma = ClampGamma(*value);
+  }
+
+  FML_LOG(INFO) << "Windows text: light_glyphs=" << tuning.light_glyphs
+                << " shader_gamma=" << tuning.shader_gamma << " contrast="
+                << (tuning.contrast.has_value()
+                        ? std::to_string(*tuning.contrast)
+                        : std::string("default"))
+                << " gamma="
+                << (tuning.gamma.has_value() ? std::to_string(*tuning.gamma)
+                                             : std::string("default"));
+  return tuning;
+}
+
+}  // namespace
+
+const WindowsTextTuning& GetWindowsTextTuning() {
+  static const WindowsTextTuning tuning = ComputeTuning();
+  return tuning;
+}
+
+#else
+
+const WindowsTextTuning& GetWindowsTextTuning() {
+  static const WindowsTextTuning tuning;
+  return tuning;
+}
+
+#endif  // FML_OS_WIN
+
+}  // namespace impeller
